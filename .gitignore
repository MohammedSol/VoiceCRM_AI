# ============================================================
# .gitignore — Opportunity Voice Assistant
# ============================================================

# --- Secrets (jamais commités) ---
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.log

# --- uv ---
# uv.lock est commité (épingle les versions)
# .python-version est commité (épingle la version Python)

# --- Node / Next.js ---
node_modules/
.next/
.vercel/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
.dockerignore

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/settings.json
.idea/
*.iml

# --- MLflow ---
mlruns/
mlflow_data/

# --- Tests ---
.testcontainers/
