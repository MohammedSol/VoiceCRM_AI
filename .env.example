# ============================================================
# .env.example — modèle de configuration, JAMAIS de vrais secrets
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=voicecrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# --- Backend ---
LOG_LEVEL=INFO
DEBUG=false
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/voicecrm

# --- Frontend ---
# URL publique du backend (accessible depuis le navigateur)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Salesforce (Sprint 1 ; credentials d'une organisation Developer Edition de test) ---
# Ne jamais committer les valeurs réelles dans .env.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://<ton-domaine-my-salesforce>
# SALESFORCE_API_VERSION=v60.0

# --- MLflow ---
# Optionnel : pour surcharger l'URI de suivi depuis l'extérieur
# MLFLOW_TRACKING_URI=http://localhost:5050

# --- Sprints futurs (ne pas remplir pour le Sprint 0) ---
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_INSTANCE_URL=
# ENCRYPTION_KEY=
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen3.5:4b
